<!-- IMPORTANT: Requires ECdistribArrayTest.xml to be run first. -->

<beast version="2.8" namespace="beast.base.spec.inference.parameter
                               :beast.base.spec.inference.operators
                               :feast
                               :feast.expressions
                               :feast.fileio.logfileiterator">

  <run spec="LogFileIterator">
    <logFileState spec="TraceLogFileState" logFileName="ECdistribArrayTest.log">
      <logFileEntry spec="LogFileRealVectorParam" fieldName="R">
        <fieldParameter id="R" spec="RealVectorParam" value="0.0"/>
      </logFileEntry>
    </logFileState>

    <logger logEvery="100" fileName="$(filebase).log">
      <log idref="R"/>
      <log id="R2" spec="ExpCalculator" value="R^2">
        <arg idref="R"/>
      </log>
    </logger>

    <logger logEvery="100000">
      <log idref="R"/>
      <log idref="R2"/>
    </logger>
  </run>
</beast>
